# Plantilla de PRODUCCIÓN. Copiar a .env en el servidor y completar.
# El backend se niega a arrancar si los secretos son débiles o COOKIE_SECURE no es true.

# === Servidor ===
NODE_ENV=production
PORT=3000
API_PREFIX=api

# === Base de datos (Windows Authentication via msnodesqlv8) ===
# El servicio de Windows que ejecuta el backend debe tener acceso a esta BD.
DB_HOST=NOMBRE-SERVIDOR\SQLEXPRESS
DB_PORT=1433
DB_NAME=Rimac21Instruccion

# === JWT === (generar valores nuevos; nunca reutilizar los de desarrollo)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=5m

# === Sesión ===
SESSION_IDLE_MINUTES=5

# === Dominio ===
# La web la sirve el propio backend, así que basta el dominio público
CORS_ORIGIN=https://asistencia.ejemplo.pe

# === Proxy inverso ===
# El proxy HTTPS (IIS, nginx o Caddy) corre en el mismo equipo
TRUST_PROXY=loopback

# === Cookies === (obligatorio true: la cookie de sesión solo viaja por HTTPS)
COOKIE_SECURE=true

# === Web compilada === (opcional; por defecto ../frontend/dist)
# FRONTEND_DIST=C:\rimac21\frontend\dist

# === Jornadas ===
# Activar solo después de fijar la fecha de inicio real de cada grupo
JORNADAS_AUTOMATICAS=false

# === Cuenta inicial ===
# Con NODE_ENV=production el seed solo crea permisos y la cuenta «admin» (sin datos demo)
# SEED_ADMIN_PASSWORD=
