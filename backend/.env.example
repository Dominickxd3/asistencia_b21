# Plantilla de desarrollo. Copiar a .env y completar los secretos.
# Para producción ver .env.production.example y docs/despliegue.md

# === Servidor ===
NODE_ENV=development
PORT=3000
API_PREFIX=api

# === Base de datos (Windows Authentication via msnodesqlv8) ===
# El proceso de NestJS corre bajo una cuenta Windows con acceso a la BD.
DB_HOST=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=Rimac21Instruccion

# === JWT ===
# Dos valores distintos y aleatorios, mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=5m

# === Sesión ===
# Minutos sin uso tras los que la sesión se cierra (también al cerrar la pestaña)
SESSION_IDLE_MINUTES=5

# === CORS ===
# Origen del servidor de desarrollo de Vite (varios separados por coma)
CORS_ORIGIN=http://localhost:4200

# === Proxy inverso (vacío en desarrollo) ===
TRUST_PROXY=

# === Cookies ===
COOKIE_SECURE=false

# === Jornadas ===
# true: crea y cierra jornadas a medianoche y al arrancar, y genera las faltas de
# fechas obligatorias pasadas desde la fecha de inicio de cada grupo.
JORNADAS_AUTOMATICAS=false

# === Cuentas iniciales (npm run seed) ===
# Opcional. Si se omiten, se genera una contraseña aleatoria y se muestra una sola vez.
# SEED_ADMIN_PASSWORD=
# SEED_JEFE_PASSWORD=
# SEED_ENCARGADO_PASSWORD=
