# === Servidor ===
NODE_ENV=development
PORT=3000
API_PREFIX=api

# === Base de datos (Windows Authentication via msnodesqlv8) ===
# El proceso de NestJS corre bajo una cuenta Windows con acceso a la BD.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Rimac21Instruccion

# === JWT ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# === CORS ===
CORS_ORIGIN=http://localhost:4200

# === Cookies ===
COOKIE_SECURE=false
