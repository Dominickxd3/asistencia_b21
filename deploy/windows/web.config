<?xml version="1.0" encoding="utf-8"?>
<!--
  Sitio IIS de Rímac 21: solo reenvía (proxy inverso) al servicio Node en el puerto 3000.
  Requiere URL Rewrite + Application Request Routing (ARR) con el proxy habilitado y la
  característica «WebSocket Protocol». Lo instala y configura configurar-iis.ps1.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Validación del certificado Let's Encrypt (win-acme): se sirve desde la carpeta del sitio -->
        <rule name="ACME" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>
        <!-- Todo por HTTPS: GPS, cámara y la cookie de sesión lo exigen -->
        <rule name="HTTP a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- API, WebSocket y la web: todo lo atiende el servicio Node -->
        <rule name="Rimac21" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Node ya comprime las respuestas; IIS no debe volver a hacerlo -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <!-- El servicio Node envía sus propias cabeceras de seguridad -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
